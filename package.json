{
  "name": "curriculo-studio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "build": "npm --prefix packages/shared run build && npm --prefix apps/api run build && npm --prefix apps/web run build && tsx --tsconfig apps/web/tsconfig.json scripts/prerender.tsx",
    "dev": "concurrently -n api,web \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "db:generate": "node scripts/database.mjs generate",
    "test": "npm --prefix apps/api run test",
    "start": "node --import tsx scripts/start.mjs",
    "db:deploy": "node scripts/database.mjs deploy",
    "check:config": "node --import tsx scripts/check-config.mjs",
    "check:launch": "node --import tsx scripts/check-config.mjs --require-integrations",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "postcss": "^8.5.3",
    "@types/node": "^22.13.10",
    "vite": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "@types/react": "^19.0.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "@tailwindcss/vite": "^4.3.3",
    "light-my-request": "^6.6.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.5.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.3.0",
    "react-dom": "^19.0.0",
    "@hookform/resolvers": "^3.10.0",
    "dotenv": "^16.4.7",
    "react": "^19.0.0",
    "lucide-react": "^0.468.0",
    "tsx": "^4.19.3",
    "prisma": "6.5.0",
    "playwright": "^1.51.1",
    "@prisma/client": "6.5.0",
    "zod": "^3.24.2",
    "helmet": "^8.0.0",
    "jose": "^6.0.8",
    "express": "^4.21.2",
    "cors": "^2.8.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
