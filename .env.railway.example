# Cole no RAW Editor do serviço da aplicação no Railway.
# O nome Postgres deve corresponder ao nome do serviço de banco no projeto.
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
PDF_CONCURRENCY=1

# APP_URL é inferida de RAILWAY_PUBLIC_DOMAIN após gerar o domínio público.
# Se usar domínio próprio, defina APP_URL com a origem HTTPS real.
# APP_URL=https://seu-dominio-real

# Para habilitar o login: preencha os dois valores reais juntos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Para habilitar compras: preencha os dois valores reais juntos.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
ADMIN_EMAILS=

# PUBLIC_API_URL e GOOGLE_REDIRECT_URI são derivadas de APP_URL.
# Deixe PORT sob controle do Railway.
